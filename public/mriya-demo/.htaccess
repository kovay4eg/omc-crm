Options -Indexes

# Temporary public lock. Keep the demo files deployed for local development,
# but deny every HTTP request until the page is ready to be published again.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>

<FilesMatch "^(config\.php|.*\.jsonl)$">
  Require all denied
</FilesMatch>
