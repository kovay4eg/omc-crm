APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Приватна скринька AdminPro. Пароль задається лише в .env на сервері.
ADMIN_PRO_MAIL_ADDRESS=post@omc.pl.ua
ADMIN_PRO_MAIL_NAME="Обласний молодіжний центр"
ADMIN_PRO_MAIL_USERNAME=post@omc.pl.ua
ADMIN_PRO_MAIL_PASSWORD=
ADMIN_PRO_MAIL_IMAP_HOST=omc.pl.ua
ADMIN_PRO_MAIL_IMAP_PORT=993
ADMIN_PRO_MAIL_IMAP_ENCRYPTION=ssl
ADMIN_PRO_MAIL_VALIDATE_CERTIFICATE=true
ADMIN_PRO_MAIL_SMTP_HOST=omc.pl.ua
ADMIN_PRO_MAIL_SMTP_PORT=465
ADMIN_PRO_MAIL_SMTP_SCHEME=smtps
ADMIN_PRO_MAIL_DEEPL_KEY=
ADMIN_PRO_MAIL_DEEPL_URL=https://api-free.deepl.com/v2/translate

# Google Calendar і читання таблиць відповідей Google Forms.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://omc.pl.ua/google/callback

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=storage/app/private/firebase-service-account.json
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_VAPID_KEY=

# Холодне сховище медіа на OMC Cloud. Увімкніть лише після створення
# окремого сервісного облікового запису без MFA та успішної перевірки upload/download SHA-256.
OMC_MEDIA_ARCHIVE_ENABLED=false
OMC_MEDIA_ARCHIVE_BASE_URL=https://pomc.com.ua
OMC_MEDIA_ARCHIVE_LOGIN=
OMC_MEDIA_ARCHIVE_PASSWORD=
OMC_MEDIA_ARCHIVE_ROOT=omc-crm-archive
OMC_MEDIA_ARCHIVE_TIMEOUT=120
OMC_MEDIA_ARCHIVE_CONNECT_TIMEOUT=15
OMC_MEDIA_ARCHIVE_VERIFY_TLS=true
OMC_MEDIA_ARCHIVE_SESSION_TTL=25200
OMC_MEDIA_ARCHIVE_TRIGGER_PERCENT=10
OMC_MEDIA_ARCHIVE_RECOVERY_PERCENT=15
OMC_MEDIA_ARCHIVE_TRIGGER_BYTES=2147483648
OMC_MEDIA_ARCHIVE_RECOVERY_BYTES=4294967296
OMC_MEDIA_ARCHIVE_ORPHAN_GRACE_DAYS=7
OMC_MEDIA_ARCHIVE_ANNOUNCEMENT_DAYS=90
OMC_MEDIA_ARCHIVE_EVENT_DAYS=180
OMC_MEDIA_ARCHIVE_BATCH_SIZE=200
OMC_MEDIA_ARCHIVE_STALE_UPLOAD_MINUTES=30

MOBILE_ANDROID_LATEST_VERSION=1.0.10
MOBILE_ANDROID_LATEST_BUILD_NUMBER=11
MOBILE_ANDROID_MINIMUM_VERSION=1.0.0
MOBILE_ANDROID_MINIMUM_BUILD_NUMBER=1
MOBILE_ANDROID_UPDATE_URL=https://omc.pl.ua/download/android
MOBILE_IOS_LATEST_VERSION=1.0.16
MOBILE_IOS_LATEST_BUILD_NUMBER=18
MOBILE_IOS_MINIMUM_VERSION=1.0.0
MOBILE_IOS_MINIMUM_BUILD_NUMBER=1
MOBILE_IOS_UPDATE_URL=https://omc.pl.ua/download/ios

VITE_APP_NAME="${APP_NAME}"
